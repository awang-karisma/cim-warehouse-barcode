# Server Configuration
SERVER_PORT=8080

# SQLite Database
DB_PATH=data/barcode.db

# Authentication (optional - leave GOOGLE_CLIENT_ID empty to disable auth)
GOOGLE_CLIENT_ID=
JWT_SECRET=
SUPERADMIN_EMAILS=

# Accurate Online Integration (optional - leave ACCURATE_PROVIDER empty to disable)
# Provider choices: official | web
ACCURATE_PROVIDER=
# For web provider:
ACCURATE_EMAIL=
ACCURATE_PASSWORD=
# For official provider:
ACCURATE_API_TOKEN=
ACCURATE_API_SIGNATURE_SECRET=
