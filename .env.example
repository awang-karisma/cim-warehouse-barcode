# Server Configuration
SERVER_PORT=8080

# SQLite Database
DB_PATH=data/barcode.db

# Optional PostgreSQL database. When set, PostgreSQL is used instead of SQLite.
# DB_PATH remains the optional source for a one-time SQLite import on PostgreSQL bootstrap.
# DATABASE_URL=postgres://username:password@hostname:5432/database?sslmode=disable
DATABASE_URL=

# Authentication (optional - leave GOOGLE_CLIENT_ID empty to disable auth)
GOOGLE_CLIENT_ID=
JWT_SECRET=
SUPERADMIN_EMAILS=

# Accurate account credential encryption (required before adding stored accounts)
# Generate a stable 32-byte key encoded as 64 hexadecimal characters.
ACCURATE_ENCRYPTION_KEY=
