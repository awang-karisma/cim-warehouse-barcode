# Server Configuration
SERVER_PORT=8080

# SQLite Database
DB_PATH=data/barcode.db

# Authentication (optional - leave GOOGLE_CLIENT_ID empty to disable auth)
GOOGLE_CLIENT_ID=
JWT_SECRET=
SUPERADMIN_EMAILS=

# Accurate account credential encryption (required before adding stored accounts)
# Generate a stable 32-byte key encoded as 64 hexadecimal characters.
ACCURATE_ENCRYPTION_KEY=
